# Python
__pycache__/
*.py[cod]
*.pyo
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp

# macOS
.DS_Store

# CellMatchR user config (contains local paths — do not commit)
# ~/.cellmatchr/config.json is outside the repo, but just in case:
config.json

# Large data files
*.czi
*.vsi
*.tif
*.tiff
*.npy

# Debug output folders (created next to data, not in repo)
DEBUG_*/
*_UNFILTERED*/
*_UNFILTERED_SUMMARY/

# Editor temporaries
*~

# Claude Code session data (local only)
.claude/

# CellMatchR validator last-used folder (local path, do not commit)
.roi_verifier_config

# CellMatchR launcher run log (local diagnostics)
CellMatchR_last_run.log

# Ad-hoc code signature for the .app — regenerated by scripts/build_cellmatchr_app.sh
CellMatchR.app/Contents/_CodeSignature/
